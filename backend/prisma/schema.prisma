// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoDocumento {
  CEDULA_CIUDADANIA
  CARNET_DIPLOMATICO
  CEDULA_EXTRANJERIA
  NIT
  PERMISO_ESPECIAL_PERMANENCIA
  PERMISO_PROTECCION_TEMPORAL
  REGISTRO_CIVIL
  SALVOCONDUCTO_PERMANENCIA
  TARJETA_IDENTIDAD
  NUIP
}

enum TipoAfiliacion {
  PERSONA_NATURAL
  PERSONA_JURIDICA
}

enum EstadoEmpresa {
  ACTIVA
  INACTIVA
}

enum RolUsuario {
  ADMINISTRADOR
  TECNICO_LIDER
  TECNICO
}

model Superadministrador {
  id            Int      @id @default(autoincrement())
  nombreUsuario String   @unique
  passwordHash  String
  creadoEn      DateTime @default(now())
}

model Empresa {
  id                   Int            @id @default(autoincrement())
  numeroContrato       Int            @unique @default(autoincrement())
  tipoAfiliacion       TipoAfiliacion
  tipoIdentificacion   TipoDocumento
  numeroIdentificacion String
  digitoVerificacion   String?
  consecutivo          String?
  razonSocial          String?
  departamento         String
  ciudad               String
  estado               EstadoEmpresa  @default(ACTIVA)
  creadaEn             DateTime       @default(now())

  responsable         Responsable?
  invitacion          Invitacion?
  usuarios            Usuario[]
  codigosRecuperacion CodigoRecuperacion[]
  piezas              Pieza[]
  movimientosPieza    MovimientoPieza[]
  clientes            Cliente[]
  cotizaciones        Cotizacion[]
  contadorCotizacion  ContadorCotizacion?
  sedes               Sede[]

  @@unique([tipoIdentificacion, numeroIdentificacion])
}

model Responsable {
  id                 Int           @id @default(autoincrement())
  empresaId          Int           @unique
  empresa            Empresa       @relation(fields: [empresaId], references: [id])
  nombres            String
  apellidos          String
  tipoDocumento      TipoDocumento
  numeroDocumento    String
  fechaExpedicion    DateTime      @db.Date
  telefono           String
  correo             String
  direccion          String
  nacionalidad1      String?
  nacionalidad2      String?
  paisNacimiento     String?
  ciudadNacimiento   String?
  profesionOcupacion String?
}

model Invitacion {
  id        Int       @id @default(autoincrement())
  token     String    @unique @default(uuid())
  creadaEn  DateTime  @default(now())
  expiraEn  DateTime
  usadaEn   DateTime?
  empresaId Int?      @unique
  empresa   Empresa?  @relation(fields: [empresaId], references: [id])
}

model Usuario {
  id                  Int                  @id @default(autoincrement())
  empresaId           Int
  empresa             Empresa              @relation(fields: [empresaId], references: [id])
  rol                 RolUsuario
  nombre              String
  nombres             String
  apellidos           String?
  tipoDocumento       TipoDocumento?
  numeroDocumento     String?
  nombreUsuario       String               @unique
  correo              String
  passwordHash        String
  activo              Boolean              @default(true)
  creadoEn            DateTime             @default(now())
  codigosRecuperacion CodigoRecuperacion[]
  movimientosPieza    MovimientoPieza[]
  cotizaciones        Cotizacion[]

  @@index([empresaId])
}

// Códigos OTP de recuperación de contraseña
model CodigoRecuperacion {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario   @relation(fields: [usuarioId], references: [id])
  empresaId  Int
  empresa    Empresa   @relation(fields: [empresaId], references: [id])
  codigoHash String // el código nunca se guarda en claro
  expiraEn   DateTime
  intentos   Int       @default(0)
  usadoEn    DateTime? // se llena al usarse o al ser reemplazado por otro código
  creadoEn   DateTime  @default(now())

  @@index([usuarioId])
  @@index([empresaId])
}

// inventario modulo
enum TipoMovimientoPieza {
  ALTA // la pieza se crea con unas existencias y un precio iniciales
  AJUSTE // suma o resta manual de existencias (cantidad con signo)
  CAMBIO_PRECIO // cambio del precio unitario
}

// Pieza del inventario
model Pieza {
  id             Int      @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  codigo         String? // opcional; único por empresa entre piezas activas (índice en la migración)
  nombre         String
  precioUnitario Decimal  @db.Decimal(12, 2) // en pesos, sin IVA
  unidades       Int      @default(0) // unidades disponibles (nunca negativas: CHECK en la migración)
  stockMinimo    Int      @default(0) // valor de control para saber cuándo reabastecer
  activo         Boolean  @default(true) // false = pieza eliminada (inactivación lógica)
  creadaEn       DateTime @default(now())

  movimientos      MovimientoPieza[]
  lineasCotizacion CotizacionLinea[]

  @@index([empresaId])
}

// Historial de la pieza dentro del inventario: no es el historial de casos ni de solicitudes
model MovimientoPieza {
  id              Int                 @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa             @relation(fields: [empresaId], references: [id])
  piezaId         Int
  pieza           Pieza               @relation(fields: [piezaId], references: [id])
  tipo            TipoMovimientoPieza
  cantidad        Int? // ALTA: existencias iniciales. AJUSTE: variación con signo
  unidadesAntes   Int?
  unidadesDespues Int?
  precioAntes     Decimal?            @db.Decimal(12, 2)
  precioDespues   Decimal?            @db.Decimal(12, 2)
  usuarioId       Int?
  usuario         Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioNombre   String // nombre de quien actuó TAL COMO ERA en ese momento, mas que todo registro
  creadoEn        DateTime            @default(now())

  @@index([piezaId, creadoEn])
  @@index([empresaId])
}

// Cliente de la empresa. Se registra y se reutiliza al crear una cotización o un caso;
// esto se hace por que no existe un módulo de gestión de clientes.
model Cliente {
  id              Int           @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa       @relation(fields: [empresaId], references: [id])
  tipoDocumento   TipoDocumento
  numeroDocumento String // normalizado: mayúsculas, sin espacios, puntos ni guiones (CHECK en la migración)
  nombre          String // nombre completo o razón social
  correo          String?
  telefono        String?
  departamento    String? // opcional; si se diligencia, la ciudad también
  ciudad          String?
  direccion       String?
  creadoEn        DateTime      @default(now())
  actualizadoEn   DateTime      @updatedAt

  cotizaciones Cotizacion[]

  // Un cliente es único por empresa; el mismo documento puede existir en empresas distintas
  @@unique([empresaId, tipoDocumento, numeroDocumento])
}

enum TipoLineaCotizacion {
  PIEZA
  SERVICIO_BASICO
  SERVICIO_ESPECIALIZADO
}

// Contador de la numeración de cotizaciones: una fila por empresa, así cada empresa
// lleva su propia secuencia, independiente de las demás
model ContadorCotizacion {
  empresaId Int     @id
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  ultimo    Int     @default(0)
}

// Cotización: registro histórico. No se modifica ni se elimina; un
// disparador de PostgreSQL lo garantiza. Guarda una COPIA de los datos del cliente al momento.
model Cotizacion {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  numero    Int // secuencial por empresa (RN-31); se muestra como COT-000123

  clienteId              Int
  cliente                Cliente       @relation(fields: [clienteId], references: [id])
  // Copia histórica del cliente: las correcciones posteriores NO alteran la cotización
  clienteTipoDocumento   TipoDocumento
  clienteNumeroDocumento String
  clienteNombre          String
  clienteCorreo          String?
  clienteTelefono        String?
  clienteDepartamento    String? // departamento de RESIDENCIA del cliente, copiado al crear la cotización
  clienteCiudad          String? // ciudad de RESIDENCIA del cliente
  clienteDireccion       String?

  ciudadServicio String // ciudad del SERVICIO: distinta de la ciudad del cliente
  diagnostico    String
  total          Decimal @db.Decimal(18, 2) // sin IVA

  creadaPorId     Int
  creadaPor       Usuario  @relation(fields: [creadaPorId], references: [id])
  creadaPorNombre String // nombre TAL COMO ERA al crearla (D-24)
  creadaEn        DateTime @default(now())

  lineas CotizacionLinea[]

  @@unique([empresaId, numero])
  @@index([empresaId, creadaEn])
  @@index([clienteId])
}

// Línea de una cotización: una pieza del inventario o un servicio. Copia el código, el nombre y el
// precio de la pieza al momento: los cambios posteriores del inventario no la alteran.
model CotizacionLinea {
  id             Int                 @id @default(autoincrement())
  cotizacionId   Int
  cotizacion     Cotizacion          @relation(fields: [cotizacionId], references: [id])
  orden          Int
  tipo           TipoLineaCotizacion
  piezaId        Int? // solo en las líneas de pieza
  pieza          Pieza?              @relation(fields: [piezaId], references: [id], onDelete: Restrict)
  codigo         String? // copia del código de la pieza
  descripcion    String // copia del nombre de la pieza, o la descripción del servicio
  cantidad       Int
  precioUnitario Decimal             @db.Decimal(12, 2)
  subtotal       Decimal             @db.Decimal(18, 2)

  @@index([cotizacionId])
  @@index([piezaId])
}

// Sede de la empresa: identifica a qué ubicación corresponde cada cotización y cada caso.
// No limita lo que ve cada usuario ni se asigna a usuarios.
model Sede {
  id           Int      @id @default(autoincrement())
  empresaId    Int
  empresa      Empresa  @relation(fields: [empresaId], references: [id])
  nombre       String // nombre o código que define la empresa; único entre las sedes activas (índice en la migración)
  direccion    String?
  departamento String
  ciudad       String
  esPrincipal  Boolean  @default(false) // una sola por empresa y siempre activa (índice y CHECK en la migración)
  activo       Boolean  @default(true) // false = sede eliminada (inactivación lógica)
  creadaEn     DateTime @default(now())

  @@index([empresaId])
}
