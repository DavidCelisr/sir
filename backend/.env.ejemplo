# Este archivo se incluye en el repositorio como referencia
# para conocer las variables necesarias para ejecutar el proyecto.

#

# El archivo .env real NO se publica en GitHub, ya que puede

# contener contraseñas, claves y otros datos sensibles.

# ============================================================

# ------------------------------------------------------------

# Configuración del servidor / API

# ------------------------------------------------------------

#

# Puerto en el que se ejecuta el backend de SIR.

# El API está configurado para ejecutarse en el puerto 3000.

#

#PORT=3000

# ------------------------------------------------------------

# Conexión con la base de datos

# ------------------------------------------------------------

#

# SIR utiliza PostgreSQL como sistema gestor de base de datos.

#

# La siguiente línea muestra únicamente el formato esperado.

# La contraseña real NO se incluye por motivos de seguridad.

#

# DATABASE_URL="postgresql://postgres:MI_CLAVE@localhost:5432/sir_dev"

#

# Donde:

# postgres    = usuario de PostgreSQL

# MI_CLAVE    = contraseña configurada localmente

# localhost   = servidor PostgreSQL local

# 5432        = puerto predeterminado de PostgreSQL

# sir_dev     = base de datos utilizada para el desarrollo de SIR

#

# La URL real se configura únicamente en el archivo .env local.

# ------------------------------------------------------------

# Creacion del Seed del superadministrador

# ------------------------------------------------------------

#SUPERADMIN_USUARIO=siradmin
#SUPERADMIN_PASSWORD=esta contraseña es la que se utiliza para crear el superadministrador en la base de datos al ejecutar el seed

# ------------------------------------------------------------

# hacer el login de superadministrador con JWT

# ------------------------------------------------------------

#JWT_SECRET= node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#JWT_EXPIRES_IN=8h [cuando se hace el login, el token expira en 8 horas]

# ============================================================
